# Copy to .env and fill in. .env is gitignored; never commit it.

# --- Generation -------------------------------------------------------------
LLM_PROVIDER=nebius
NEBIUS_API_KEY=
# NEBIUS_MODEL=meta-llama/Llama-3.3-70B-Instruct
# (run `python list_models.py` to see what the endpoint actually serves)

# Alternative provider. Set LLM_PROVIDER=anthropic to use it.
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Embeddings -------------------------------------------------------------
# local = bge-small on CPU, no API cost, ~2 min for the whole corpus.
EMBED_PROVIDER=local

# --- Resume parsing (optional) ----------------------------------------------
# Without this the app uses pypdf / python-docx, which is fine for
# single-column resumes and worse for two-column templates.
# LLAMA_CLOUD_API_KEY=

# --- Retrieval --------------------------------------------------------------
# TOP_K_RETRIEVE=20
# TOP_K_CONTEXT=5
# Set this from `python eval/run_eval.py --sweep-threshold`, not by guessing.
# 0.60 is the swept value for this corpus; every published result assumes it.
# MIN_SIM=0.60
